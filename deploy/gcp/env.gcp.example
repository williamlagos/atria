# ==============================================================================
# Google Cloud Platform Deployment Environment Variables
# ==============================================================================
# In production on Cloud Run, sensitive credentials are stored in Secret Manager,
# while non-sensitive configuration is set as service environment variables.

# Core Django Settings
DJANGO_SETTINGS_MODULE=atria.settings
DEBUG=0
SECRET_KEY=generate-a-strong-random-50-character-key
ALLOWED_HOSTS=*
SITE_DOMAIN=atria.internal
PORT=8000

# Cloud SQL (PostgreSQL 16)
# Local Cloud SQL Auth Proxy socket format:
DATABASE_URL=postgres://atria:YOUR_DB_PASSWORD@localhost:5432/atria?host=/cloudsql/PROJECT_ID:REGION:INSTANCE_NAME

# Google Cloud Storage (Media & Assets - 5 GB Always Free tier)
GS_BUCKET_NAME=atria-media-YOUR_PROJECT_ID
GS_DEFAULT_ACL=publicRead
GS_QUERYSTRING_AUTH=False

# AI & Semantic Discovery (Google Gemini)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Payments & Commerce
STRIPE_SECRET_KEY=YOUR_STRIPE_SECRET_KEY
WEB3_PROVIDER_URL=https://eth.llamarpc.com

# Asynchronous Tasks / Broker
CELERY_BROKER_URL=memory://
CELERY_RESULT_BACKEND=cache+memory://
